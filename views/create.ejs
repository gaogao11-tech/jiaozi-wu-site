<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="管理员创建新项目页面。" />
  <title>创建项目 - 饺子的神奇小窝</title>
  <link rel="stylesheet" href="/css/style.css" />
  <script src="https://kit.fontawesome.com/a2e0b9e4f8.js" crossorigin="anonymous"></script>
</head>
<body class="bg">
  <%- include('partials/header', { user: user }) %>
  <main class="content">
    <div class="card">
      <h1>创建新项目</h1>
      <% if (error) { %>
        <div class="error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
      <% } %>
      <form method="post" action="/create" enctype="multipart/form-data">
        <label>项目名称</label>
        <input type="text" name="title" required />

        <label>项目描述</label>
        <textarea name="description" rows="4" required></textarea>

        <label>项目展示图 URL</label>
        <input type="url" name="imageUrl" placeholder="可选" />
        <label>本地项目展示图上传（优先）</label>
        <input type="file" name="imageFile" accept="image/*" />

        <label>功能示意图 URL</label>
        <input type="url" name="diagramUrl" placeholder="可选" />
        <label>本地功能示意图上传（优先）</label>
        <input type="file" name="diagramFile" accept="image/*" />

        <label>项目链接</label>
        <input type="url" name="linkUrl" required />

        <label>演示视频 URL</label>
        <input type="url" name="videoUrl" placeholder="可选" />
        <label>本地视频文件上传（优先）</label>
        <input type="file" name="videoFile" accept="video/*" />

        <label>标签（逗号分隔）</label>
        <input type="text" name="tags" placeholder="例如: 动漫, 科技" />

        <button class="btn" type="submit">创建项目</button>
      </form>
    </div>
  </main>
  <%- include('partials/footer') %>

